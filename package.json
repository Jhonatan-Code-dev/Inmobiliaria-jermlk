{
  "name": "alquilamax-jermlk",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "env:sync": "node scripts/sync-env.mjs",
    "dev": "npm run env:sync && ng serve --proxy-config proxy.conf.json",
    "start": "npm run env:sync && ng serve --proxy-config proxy.conf.json",
    "build": "npm run env:sync && ng build",
    "watch": "npm run env:sync && ng build --watch --configuration development",
    "test": "npm run env:sync && ng test",
    "deploy": "npm run build && wrangler deploy",
    "preview": "npm run build && wrangler dev",
    "postinstall": "npm run env:sync"
  },
  "private": true,
  "packageManager": "npm@10.9.2",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.2.2",
    "tslib": "^2.3.0",
    "zone.js": "^0.16.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.6",
    "@angular/cli": "^21.2.6",
    "@angular/compiler-cli": "^21.2.0",
    "@ngx-env/builder": "^21.0.1",
    "@tailwindcss/postcss": "^4.1.12",
    "dotenv": "^17.4.1",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8",
    "wrangler": "^4.80.0",
    "zod": "^4.3.6"
  }
}
